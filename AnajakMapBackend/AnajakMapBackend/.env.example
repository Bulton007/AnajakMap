# Run scripts/init-dev.sh to create local secrets and .env; never commit .env.
# Optional host port override when 8080 is occupied (Flutter API_BASE_URL must match).
GATEWAY_HTTP_PORT=8080
# Driving routes: an owned/licensed OSRM service for production. Blank locally
# uses the opt-in public, non-commercial demo; no uptime/live-traffic guarantee.
OSRM_URL=
OSRM_DEMO_ENABLED=true
# Enable only after verifying your selected Gemini model's image/audio support.
GEMINI_VISION_ENABLED=false
GEMINI_VOICE_ENABLED=false
# Separate, non-redeemable account practice; never bypasses reviewed field places.
RPG_SIMULATION_ENABLED=false
ORACLE_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
RABBIT_USER=anajak
RABBIT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SERVICE_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_VALUE
OBJECT_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
OBJECT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_DER_PUBLIC_KEY
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_DER_PKCS8_PRIVATE_KEY
IDENTITY_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRIP_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
AI_GUIDE_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DISCOVERY_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
EXPENSE_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
RESERVATION_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
JOURNAL_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
NOTIFICATION_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
GATEWAY_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
IDENTITY_APP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRIP_APP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
AI_GUIDE_APP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DISCOVERY_APP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
EXPENSE_APP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
RESERVATION_APP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
JOURNAL_APP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
NOTIFICATION_APP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
