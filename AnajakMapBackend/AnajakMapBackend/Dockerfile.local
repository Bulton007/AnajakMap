FROM eclipse-temurin:21-jre-alpine
ARG SERVICE
WORKDIR /opt/anajakmap
COPY ${SERVICE}-service/target/${SERVICE}-service-0.1.0-SNAPSHOT.jar app.jar
RUN mkdir logs && chgrp -R 0 /opt/anajakmap && chmod -R g=u /opt/anajakmap
ENV LOG_PATH=/opt/anajakmap/logs
USER 1001
ENTRYPOINT ["java","-Xms64m","-Xmx256m","-jar","app.jar"]
